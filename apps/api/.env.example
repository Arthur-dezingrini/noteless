# Connection string do Neon, copiada do painel (Connection Details). Peça ao
# time por mensagem privada. O driver fala WebSocket na 443, então funciona
# mesmo em rede que bloqueia a 5432.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo de assinatura das sessões. Gere o seu com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Onde ESTA api responde (o Better Auth usa para montar URLs e checar origem).
BETTER_AUTH_URL="http://localhost:4000"

# Origem do front. Requisições de outra origem são rejeitadas.
WEB_URL="http://localhost:3000"

PORT=4000

# --- IA das ocorrências ---
# Grátis: crie uma chave em https://console.groq.com/keys. Com só esta variável
# a transcrição (Whisper) e a interpretação (openai/gpt-oss-120b) rodam na Groq.
GROQ_API_KEY=""

# Opcional (pago): com esta chave a interpretação passa a usar o Claude.
# ANTHROPIC_API_KEY=""

# Opcional: troca o modelo de interpretação do provedor em uso
# (ex.: llama-3.3-70b-versatile na Groq, claude-sonnet-5 na Anthropic).
# IA_MODELO=""

# Opcional: transcrever em outro serviço compatível com a API da OpenAI.
# TRANSCRICAO_API_KEY=""
# TRANSCRICAO_BASE_URL="https://api.openai.com/v1"
# TRANSCRICAO_MODELO="whisper-1"
