# Connection string do Neon, copiada do painel (Connection Details). Peça ao
# time por mensagem privada. O driver fala WebSocket na 443, então funciona
# mesmo em rede que bloqueia a 5432.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo de assinatura das sessões. Gere o seu com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Endereço público pelo qual o navegador chega na api. Local, a api responde
# direto na 4000. Na Vercel (front e api em projetos separados), o navegador
# só fala com o front, que repassa /api/* — lá, as duas são a URL DO FRONT.
BETTER_AUTH_URL="http://localhost:4000"

# Origem do front. Login vindo de outra origem é recusado.
WEB_URL="http://localhost:3000"

# Opcional: outras origens que podem fazer login, separadas por vírgula
# (domínio próprio, endereço de preview da Vercel).
# ORIGENS_EXTRAS="https://app.exemplo.com.br"

PORT=4000

# --- IA das ocorrências ---
# Grátis: crie uma chave em https://console.groq.com/keys. Com só esta variável
# a transcrição (Whisper) e a interpretação (openai/gpt-oss-120b) rodam na Groq.
GROQ_API_KEY=""

# Opcional (pago): com esta chave a interpretação passa a usar o Claude.
# ANTHROPIC_API_KEY=""

# Opcional: troca o modelo de interpretação do provedor em uso
# (ex.: llama-3.3-70b-versatile na Groq, claude-sonnet-5 na Anthropic).
# IA_MODELO=""

# Opcional: transcrever em outro serviço compatível com a API da OpenAI.
# TRANSCRICAO_API_KEY=""
# TRANSCRICAO_BASE_URL="https://api.openai.com/v1"
# TRANSCRICAO_MODELO="whisper-1"

# --- E-mail: esqueci a senha e alertas (opcional) ---
# Chave da Resend (https://resend.com). Sem ela nada é enviado; fora de
# produção, o link de "esqueci a senha" sai no terminal da api.
# RESEND_API_KEY=
# Remetente; sem ele sai como "Noteless <onboarding@resend.dev>", que só
# entrega para o dono da conta na Resend. Use um endereço de domínio verificado.
# EMAIL_REMETENTE=
# Quem recebe os alertas, separados por vírgula.
# ALERTA_EMAILS=

# --- Rotina diária (opcional) ---
# Autoriza a rotina do GitHub Actions a apagar o áudio vencido; o mesmo valor
# vai no segredo ROTINAS_SEGREDO do repositório. Sem ele, a rota responde 503.
# ROTINAS_SEGREDO=

# --- Firmware do gravador (opcional) ---
# Chave privada EC P-256 (PEM) que assina o firmware publicado; a pública vai
# no firmware (gravador.ino). Sem ela, publicar firmware responde 503.
# FIRMWARE_CHAVE_PRIVADA=
