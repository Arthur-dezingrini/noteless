# Postgres local. Crie o papel e o banco com o comando do README.
DATABASE_URL="postgresql://vocare:vocare@localhost:5432/vocare"

# Segredo de assinatura das sessões. Gere o seu com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Onde ESTA api responde (o Better Auth usa para montar URLs e checar origem).
BETTER_AUTH_URL="http://localhost:4000"

# Origem do front. Requisições de outra origem são rejeitadas.
WEB_URL="http://localhost:3000"

PORT=4000
