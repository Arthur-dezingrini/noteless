# Connection string do Neon, copiada do painel (Connection Details). Peça ao
# time por mensagem privada. O driver fala WebSocket na 443, então funciona
# mesmo em rede que bloqueia a 5432.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo de assinatura das sessões. Gere o seu com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Onde ESTA api responde (o Better Auth usa para montar URLs e checar origem).
BETTER_AUTH_URL="http://localhost:4000"

# Origem do front. Requisições de outra origem são rejeitadas.
WEB_URL="http://localhost:3000"

PORT=4000
