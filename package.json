{
  "name": "vocare",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "auth:generate": "npm run auth:generate -w apps/api",
    "seed": "npm run seed -w apps/api --"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.12.1"
}
